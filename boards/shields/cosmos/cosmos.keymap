// Translated from designs/cosmos-keyboard/cosmos-41.kls.json (layers 0 + 1).
// Key order follows default_transform in cosmos.dtsi.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
    &kp Q &kp W &kp E &kp R &kp T                      &kp Y &kp U &kp I     &kp O   &kp P
    &kp A &kp S &kp D &kp F &kp G                      &kp H &kp J &kp K     &kp L   &kp RSHFT
    &kp Z &kp X &kp C &kp V &kp B                      &kp N &kp M &kp COMMA &kp DOT &kp SLASH
          &kp ESC &kp TAB                                          &kp LPAR  &kp QMARK
    &kp LGUI &kp SPACE &mo 1 &kp RET                   &kp LCTRL &kp BSPC &kp LALT
            >;
        };

        lower {
            bindings = <
    &kp N1 &kp N2 &kp N3      &kp N4      &kp N5       &kp N6   &kp N7   &kp N8 &kp N9    &kp N0
    &trans &trans &mkp MCLK   &mkp LCLK   &mkp RCLK    &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans
    &trans &trans &trans      &trans      &trans       &trans   &trans   &trans &trans    &trans
           &trans &trans                                                 &trans &trans
    &trans &trans &trans &trans                        &trans &trans &trans
            >;
        };
    };
};
