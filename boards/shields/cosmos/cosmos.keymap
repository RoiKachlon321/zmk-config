// Translated from designs/cosmos-keyboard/cosmos-41.kls.json (layers 0 + 1).
// Key order follows default_transform in cosmos.dtsi.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
    &kp Q &kp W &kp E &kp R &kp T                      &kp Y &kp U &kp I     &kp O   &kp P
    &kp A &kp S &kp D &kp F &kp G                      &kp H &kp J &kp K     &kp L   &kp RSHFT
    &kp Z &kp X &kp C &kp V &kp B                      &kp N &kp M &kp COMMA &kp DOT &kp SLASH
          &kp ESC &kp TAB                                          &kp QMARK &mo 3
    &kp LCTRL &kp SPACE &kp LGUI &mo 1                 &kp RET &kp BSPC &kp LALT
            >;
        };

        lower {
            display-name = "Lower";
            // Lower + Esc (left thumb) = studio_unlock (ZMK Studio asks for it before editing).
            // Lower + Backspace (hold both) = System layer (flashing keys), see below.
            // Bottom row = Cmd + the digit directly above it (Z = Cmd+1 ... / = Cmd+0).
            bindings = <
    &kp N1     &kp N2     &kp N3     &kp N4     &kp N5        &kp N6     &kp N7     &kp N8     &kp N9     &kp N0
    &trans     &trans     &mkp MCLK  &mkp RCLK  &mkp LCLK     &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT  &trans
    &kp LG(N1) &kp LG(N2) &kp LG(N3) &kp LG(N4) &kp LG(N5)    &kp LG(N6) &kp LG(N7) &kp LG(N8) &kp LG(N9) &kp LG(N0)
           &studio_unlock &trans                                         &trans &trans
    &trans &trans &trans &trans                        &trans &mo 2 &trans
            >;
        };

        system {
            display-name = "System";
            // Hold Lower + Backspace, then: Q = LEFT half flashing mode, P = RIGHT half flashing mode.
            // &bootloader acts on the half its key is on (same as double-tapping RST+GND).
            // Not a combo on purpose: combos always run reset behaviors on the central (right) half.
            bindings = <
    &bootloader &none &none &none &none                &none &none &none &none &bootloader
    &none &none &none &none &none                      &none &none &none &none &none
    &none &none &none &none &none                      &none &none &none &none &none
          &none &none                                              &none &none
    &none &none &none &trans                           &none &trans &none
            >;
        };

        sym {
            display-name = "Sym";
            // Hold the right key under "." (was ?). F-keys sit on the digit keys (F5/F6 moved to M/, because
            // T/Y hold [ ]). Openers on T/G/B, closers on Y/H/N. Most symbols on the left (Iris habit).
            // Left thumb keys = media, so the free left hand runs them while the right holds Sym.
            bindings = <
    &kp F1    &kp F2    &kp F3    &kp F4    &kp LBKT       &kp RBKT &kp F7  &kp F8   &kp F9   &kp F10
    &kp TILDE &kp PLUS  &kp UNDER &kp MINUS &kp LBRC       &kp RBRC &kp SQT &kp DQT  &kp SEMI &kp COLON
    &kp GRAVE &kp BSLH  &kp PIPE  &kp EQUAL &kp LPAR       &kp RPAR &kp F5  &kp F6   &kp F11  &kp F12
          &kp C_MUTE &kp C_PREV                                            &trans &trans
    &kp C_VOL_DN &kp C_PP &kp C_VOL_UP &kp C_NEXT          &trans &trans &trans
            >;
        };

        // Empty spare layers that ZMK Studio can turn on and fill later.
        extra1 { status = "reserved"; };
        extra2 { status = "reserved"; };
        extra3 { status = "reserved"; };
    };
};
